<div class="tiktok-experience" data-controller="tiktok-feed">
  <!-- Toast feedback for sound/actions -->
  <div class="tiktok-toast-pill d-none" data-tiktok-feed-target="toast"></div>

  <!-- Exit Clear Screen floating pill button (visible only when clear screen is active) -->
  <button type="button"
          class="exit-clear-screen-pill d-none"
          data-tiktok-feed-target="exitClearScreenBtn"
          data-action="click->tiktok-feed#exitClearScreen"
          title="Salir de pantalla limpia">
    <i class="ri-eye-line"></i>
    <span>Salir de pantalla limpia</span>
  </button>

  <!-- Top Navigation Header (Compact & non-overlapping) -->
  <header class="tiktok-nav-header">
    <div class="tiktok-header-top-row">
      <div class="tiktok-tabs-container">
        <%= link_to discovers_path(tab: "nearby", location: (@search_location.presence || "Puebla")),
                    class: "tiktok-tab-link #{@current_tab == 'nearby' ? 'active' : ''}" do %>
          <i class="ri-map-pin-user-fill"></i>
          <span><%= t('discover.tabs.nearby', default: "Cerca de ti") %></span>
        <% end %>

        <span class="tiktok-tabs-divider">|</span>

        <%= link_to discovers_path(tab: "for_you"),
                    class: "tiktok-tab-link #{@current_tab == 'for_you' ? 'active' : ''}" do %>
          <span><%= t('discover.tabs.for_you', default: "Para ti") %></span>
        <% end %>

        <span class="tiktok-tabs-divider">|</span>

        <%= link_to discovers_path(tab: "genre", genre: (@current_genre.presence || "Tropical")),
                    class: "tiktok-tab-link #{@current_tab == 'genre' ? 'active' : ''}" do %>
          <i class="ri-disc-fill"></i>
          <span class="tab-label-full d-none d-sm-inline"><%= t('discover.tabs.by_genre', default: "Escucha por género") %></span>
          <span class="tab-label-short d-sm-none"><%= t('discover.tabs.by_genre_short', default: "Por género") %></span>
        <% end %>
      </div>

      <!-- Quick Language Switcher Button -->
      <% next_locale = (I18n.locale.to_s == 'es' ? :en : :es) %>
      <div class="tiktok-lang-switcher-wrap">
        <%= link_to set_language_path(locale: next_locale),
                    class: "tiktok-lang-btn",
                    data: { turbo: false },
                    title: (I18n.locale.to_s == 'es' ? "Switch to English" : "Cambiar a Español") do %>
          <i class="ri-global-line lang-icon"></i>
          <span class="lang-switch-tag <%= 'is-active' if I18n.locale.to_s == 'es' %>">ES</span>
          <span class="lang-switch-sep">/</span>
          <span class="lang-switch-tag <%= 'is-active' if I18n.locale.to_s == 'en' %>">EN</span>
        <% end %>
      </div>
    </div>

    <!-- Sub-bar for "Cerca de ti": Location Search + Events Cross-link -->
    <% if @current_tab == "nearby" %>
      <div class="tiktok-header-search-container" data-controller="search-autocomplete">
        <%= form_with url: discovers_path, method: :get, local: true, class: "tiktok-search-form", data: { search_autocomplete_target: "form" } do %>
          <%= hidden_field_tag :tab, "nearby" %>
          <div class="tiktok-search-input-wrapper">
            <i class="ri-map-pin-2-fill search-icon text-danger"></i>
            <%= text_field_tag :location,
                               @search_location,
                               placeholder: "Buscar ciudad o ubicación...",
                               class: "tiktok-search-input",
                               autocomplete: "off",
                               data: {
                                 search_autocomplete_target: "input",
                                 action: "focus->search-autocomplete#onFocus input->search-autocomplete#onInput"
                               } %>
            <% if params[:location].present? && params[:location] != "Puebla" %>
              <%= link_to discovers_path(tab: "nearby", location: "Puebla"), class: "tiktok-search-clear", title: "Restablecer" do %>
                <i class="ri-close-circle-fill"></i>
              <% end %>
            <% end %>
            <button type="submit" class="tiktok-search-btn" title="Buscar ubicación">
              <i class="ri-search-2-line"></i>
            </button>
          </div>
        <% end %>

        <!-- Autocomplete Suggestions Dropdown -->
        <div class="tiktok-search-dropdown d-none" data-search-autocomplete-target="dropdown">
          <div class="dropdown-header">
            <i class="ri-compass-3-line text-danger"></i>
            <span>Ubicaciones recomendadas</span>
          </div>
          <div class="dropdown-items-list" data-search-autocomplete-target="list">
            <% @available_locations.each do |loc| %>
              <div class="dropdown-item-row"
                   data-search-autocomplete-target="item"
                   data-search-value="<%= loc %>"
                   data-action="click->search-autocomplete#selectItem">
                <i class="ri-map-pin-2-line item-icon"></i>
                <span class="item-text"><%= loc %></span>
                <% if @search_location.to_s.downcase == loc.downcase %>
                  <span class="item-badge active">Actual</span>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Location Context Action Bar: Listen vs Events -->
        <div class="tiktok-feed-context-bar">
          <div class="context-info">
            <i class="ri-map-pin-2-fill text-danger"></i>
            <span>
              <%= @search_location %>
              <small class="count-tag">(<%= @discovers.count %> <%= @discovers.count == 1 ? 'video' : 'videos' %>)</small>
            </span>
          </div>

          <%= link_to events_path(query: @search_location), class: "tiktok-switch-events-btn location-variant", title: "Buscar eventos en #{@search_location}" do %>
            <i class="ri-calendar-event-fill"></i>
            <span><%= t('discover.actions.see_events_in', location: @search_location, default: "Ver eventos en #{@search_location}") %></span>
            <i class="ri-arrow-right-s-line arrow-subtle"></i>
          <% end %>
        </div>
      </div>

    <!-- Sub-bar for "Por género": Horizontal Genre Carousel + Genre Events Cross-link -->
    <% elsif @current_tab == "genre" %>
      <div class="tiktok-genre-header-container">
        <!-- Horizontal Genre Chips Selector -->
        <div class="tiktok-genre-chips-scroll">
          <%= link_to discovers_path(tab: "genre", genre: "Todos"),
                      class: "tiktok-genre-pill-chip #{(@current_genre.blank? || ['Todos', 'All'].include?(@current_genre)) ? 'active' : ''}" do %>
            <i class="ri-apps-2-line"></i>
            <span><%= t('discover.actions.all_genres', default: "Todos") %></span>
          <% end %>

          <% @available_genres.each do |genre| %>
            <%= link_to discovers_path(tab: "genre", genre: genre),
                        class: "tiktok-genre-pill-chip #{@current_genre.to_s.downcase == genre.downcase ? 'active' : ''}" do %>
              <% if genre.downcase == 'tropical' %>
                <i class="ri-sun-fill text-warning"></i>
              <% elsif genre.downcase == 'rock' %>
                <i class="ri-fire-fill text-danger"></i>
              <% elsif genre.downcase == 'pop' %>
                <i class="ri-headphone-fill text-info"></i>
              <% elsif genre.downcase == 'urban' || genre.downcase == 'urbano' %>
                <i class="ri-building-line text-secondary"></i>
              <% elsif genre.downcase == 'jazz' %>
                <i class="ri-music-fill text-warning"></i>
              <% elsif genre.downcase == 'dj' %>
                <i class="ri-disc-line text-primary"></i>
              <% else %>
                <i class="ri-music-2-line"></i>
              <% end %>
              <span><%= genre %></span>
            <% end %>
          <% end %>
        </div>

        <!-- Genre Context Action Bar: Listen vs Events -->
        <div class="tiktok-feed-context-bar">
          <div class="context-info">
            <i class="ri-disc-fill text-pink"></i>
            <span>
              <% if @current_genre.blank? || ['Todos', 'All'].include?(@current_genre) %>
                <%= t('discover.actions.listening_all', default: "Todos los géneros") %>
              <% else %>
                <strong><%= @current_genre %></strong>
              <% end %>
              <small class="count-tag">(<%= @discovers.count %> <%= @discovers.count == 1 ? 'video' : 'videos' %>)</small>
            </span>
          </div>

          <%= link_to events_path(genre: (@current_genre.present? && !['Todos', 'All'].include?(@current_genre) ? @current_genre : nil)),
                      class: "tiktok-switch-events-btn",
                      title: "Buscar eventos de este género" do %>
            <i class="ri-calendar-event-fill"></i>
            <span>
              <% if @current_genre.present? && !['Todos', 'All'].include?(@current_genre) %>
                <%= t('discover.actions.see_events_of', genre: @current_genre, default: "Ver eventos de #{@current_genre}") %>
              <% else %>
                <%= t('discover.actions.see_all_events', default: "Ver todos los eventos") %>
              <% end %>
            </span>
            <i class="ri-arrow-right-s-line arrow-subtle"></i>
          <% end %>
        </div>
      </div>

    <!-- Sub-bar for "Para ti": Search Form with Autocomplete -->
    <% else %>
      <div class="tiktok-header-search-container" data-controller="search-autocomplete">
        <%= form_with url: discovers_path, method: :get, local: true, class: "tiktok-search-form", data: { search_autocomplete_target: "form" } do %>
          <%= hidden_field_tag :tab, "for_you" %>
          <div class="tiktok-search-input-wrapper">
            <i class="ri-search-2-line search-icon text-primary"></i>
            <%= text_field_tag :query,
                               @query,
                               placeholder: "Buscar canciones, artistas o géneros...",
                               class: "tiktok-search-input",
                               autocomplete: "off",
                               data: {
                                 search_autocomplete_target: "input",
                                 action: "focus->search-autocomplete#onFocus input->search-autocomplete#onInput"
                               } %>
            <% if @query.present? %>
              <%= link_to discovers_path(tab: "for_you"), class: "tiktok-search-clear", title: "Limpiar búsqueda" do %>
                <i class="ri-close-circle-fill"></i>
              <% end %>
            <% end %>
            <button type="submit" class="tiktok-search-btn" title="Buscar música">
              <i class="ri-search-2-line"></i>
            </button>
          </div>
        <% end %>

        <!-- Autocomplete Suggestions Dropdown for Artists and Genres -->
        <div class="tiktok-search-dropdown d-none" data-search-autocomplete-target="dropdown">
          <div class="dropdown-header">
            <i class="ri-user-star-line text-primary"></i>
            <span>Artistas recomendados</span>
          </div>
          <div class="dropdown-items-list" data-search-autocomplete-target="list">
            <% @recommended_artists.each do |artist_name, genre| %>
              <div class="dropdown-item-row"
                   data-search-autocomplete-target="item"
                   data-search-value="<%= artist_name %>"
                   data-action="click->search-autocomplete#selectItem">
                <div class="artist-icon-circle">
                  <%= artist_name.first.upcase %>
                </div>
                <div class="item-info">
                  <span class="item-text"><%= artist_name %></span>
                  <small class="item-sub"><%= genre %></small>
                </div>
                <i class="ri-arrow-right-s-line arrow-icon"></i>
              </div>
            <% end %>
          </div>

          <div class="dropdown-header mt-2">
            <i class="ri-disc-line text-warning"></i>
            <span>Géneros populares</span>
          </div>
          <div class="dropdown-genres-chips">
            <% @recommended_genres.each do |genre| %>
              <button type="button"
                      class="genre-chip-btn"
                      data-search-autocomplete-target="item"
                      data-search-value="<%= genre %>"
                      data-action="click->search-autocomplete#selectItem">
                <i class="ri-music-2-line"></i> <%= genre %>
              </button>
            <% end %>
          </div>
        </div>

        <% if @query.present? %>
          <div class="tiktok-active-filter-badge">
            <span>Resultados para: <strong>"<%= @query %>"</strong> (<%= @discovers.count %>)</span>
            <%= link_to discovers_path(tab: "for_you"), class: "badge-clear-btn" do %>
              <i class="ri-close-line"></i> Quitar filtro
            <% end %>
            <%= link_to events_path(query: @query), class: "badge-events-btn ms-2", title: "Ver eventos relacionados" do %>
              <i class="ri-calendar-event-fill"></i> Ver eventos
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </header>

  <!-- Vertical Snap-Scrolling Feed Container -->
  <main class="tiktok-feed-viewport" data-tiktok-feed-target="feedViewport">
    <% if @discovers.any? %>
      <div class="tiktok-feed-track">
        <%= render partial: "discovers/tiktok_card", collection: @discovers, as: :discover %>
      </div>
    <% else %>
      <div class="tiktok-empty-feed">
        <div class="empty-feed-card">
          <div class="empty-feed-icon">
            <% if @current_tab == "nearby" %>
              <i class="ri-map-pin-range-line"></i>
            <% elsif @current_tab == "genre" %>
              <i class="ri-disc-line"></i>
            <% else %>
              <i class="ri-search-eye-line"></i>
            <% end %>
          </div>
          <% if @current_tab == "nearby" %>
            <h2>No hay videos en <%= @search_location %> aún</h2>
            <p>Sé el primero en subir un video o explora los eventos en esta ciudad.</p>
            <div class="empty-feed-actions">
              <%= link_to "Ver feed 'Para ti'", discovers_path(tab: "for_you"), class: "main-app-btn-pri" %>
              <%= link_to "Explorar eventos en #{@search_location}", events_path(query: @search_location), class: "main-app-btn-sec" %>
            </div>
          <% elsif @current_tab == "genre" %>
            <h2>No hay videos de <%= @current_genre %> aún</h2>
            <p>Explora otros géneros musicales o consulta los eventos disponibles para este género.</p>
            <div class="empty-feed-actions">
              <%= link_to "Ver todos los géneros", discovers_path(tab: "genre", genre: "Todos"), class: "main-app-btn-pri" %>
              <%= link_to "Ver eventos de #{@current_genre}", events_path(genre: @current_genre), class: "main-app-btn-sec" %>
            </div>
          <% else %>
            <h2>No se encontraron resultados para "<%= @query %>"</h2>
            <p>Intenta con el nombre de otro artista, canción o género musical (ej. Tropical, Jazz, Rock, DJ).</p>
            <div class="empty-feed-actions">
              <%= link_to "Ver todas las canciones", discovers_path(tab: "for_you"), class: "main-app-btn-pri" %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </main>

  <!-- Video Options Modal / Bottom Sheet (Triggered by Long-Press or Right-Click) -->
  <div class="tiktok-options-backdrop d-none"
       data-tiktok-feed-target="optionsBackdrop"
       data-action="click->tiktok-feed#onBackdropClick">
    <div class="tiktok-options-sheet"
         data-tiktok-feed-target="optionsSheet"
         data-action="click->tiktok-feed#stopPropagation">
      <div class="sheet-drag-handle"></div>
      <div class="sheet-header">
        <div class="sheet-header-title">
          <i class="ri-sound-module-fill sheet-title-icon"></i>
          <span><%= t('discover.sheet.title', default: "Opciones de Reproducción") %></span>
        </div>
        <button type="button" class="sheet-close-btn" data-action="click->tiktok-feed#closeOptionsMenu" title="Cerrar">
          <i class="ri-close-line"></i>
        </button>
      </div>

      <div class="sheet-content">
        <!-- Option 1: Pantalla Limpia (Clear Screen) -->
        <div class="sheet-option-item">
          <div class="option-icon-box">
            <i class="ri-fullscreen-line"></i>
          </div>
          <div class="option-info">
            <span class="option-label"><%= t('discover.sheet.clear_screen', default: "Pantalla limpia") %></span>
            <span class="option-desc"><%= t('discover.sheet.clear_screen_desc', default: "Oculta controles y textos para ver solo el video") %></span>
          </div>
          <button type="button"
                  class="option-toggle-btn"
                  data-tiktok-feed-target="clearScreenSwitch"
                  data-action="click->tiktok-feed#toggleClearScreen"
                  title="Alternar pantalla limpia">
            <span class="toggle-track">
              <span class="toggle-thumb"></span>
            </span>
          </button>
        </div>

        <!-- Option 2: Desplazamiento Automático (Auto-scroll) -->
        <div class="sheet-option-item">
          <div class="option-icon-box">
            <i class="ri-skip-down-line"></i>
          </div>
          <div class="option-info">
            <span class="option-label"><%= t('discover.sheet.auto_scroll', default: "Desplazamiento automático") %></span>
            <span class="option-desc"><%= t('discover.sheet.auto_scroll_desc', default: "Pasa al siguiente video al terminar el actual") %></span>
          </div>
          <button type="button"
                  class="option-toggle-btn"
                  data-tiktok-feed-target="autoScrollSwitch"
                  data-action="click->tiktok-feed#toggleAutoScroll"
                  title="Alternar auto-scroll">
            <span class="toggle-track">
              <span class="toggle-thumb"></span>
            </span>
          </button>
        </div>

        <!-- Option 3: Idioma / Language -->
        <div class="sheet-option-item">
          <div class="option-icon-box">
            <i class="ri-global-line"></i>
          </div>
          <div class="option-info">
            <span class="option-label"><%= t('discover.sheet.language', default: "Idioma / Language") %></span>
            <span class="option-desc"><%= t('discover.sheet.currently_in', default: "Actualmente en Español") %></span>
          </div>
          <div class="sheet-lang-pills">
            <%= link_to set_language_path(locale: :es),
                        class: "sheet-lang-btn #{'active' if I18n.locale.to_s == 'es'}",
                        data: { turbo: false } do %>
              Español
            <% end %>
            <%= link_to set_language_path(locale: :en),
                        class: "sheet-lang-btn #{'active' if I18n.locale.to_s == 'en'}",
                        data: { turbo: false } do %>
              English
            <% end %>
          </div>
        </div>

        <!-- Option 4: Velocidad de Reproducción -->
        <div class="sheet-option-group">
          <div class="group-header">
            <div class="option-icon-box">
              <i class="ri-speed-line"></i>
            </div>
            <div class="option-info">
              <span class="option-label"><%= t('discover.sheet.speed', default: "Velocidad de reproducción") %></span>
              <span class="option-desc"><%= t('discover.sheet.speed_desc', default: "Se guardará tu preferencia persistente para todos los videos") %></span>
            </div>
          </div>
          <div class="speed-pills-row">
            <% [0.5, 0.75, 1.0, 1.5, 2.0].each do |rate| %>
              <button type="button"
                      class="speed-pill-btn <%= 'active' if rate == 1.0 %>"
                      data-tiktok-feed-target="speedPill"
                      data-speed="<%= rate %>"
                      data-action="click->tiktok-feed#selectSpeed">
                <%= rate == 1.0 ? '1x Normal' : "#{rate}x" %>
              </button>
            <% end %>
          </div>
        </div>

        <!-- Quick Discovery Links Section -->
        <div class="sheet-shortcuts-section">
          <% if @current_tab == "nearby" %>
            <%= link_to events_path(query: @search_location), class: "sheet-shortcut-action-btn" do %>
              <i class="ri-calendar-event-fill text-danger"></i>
              <span><%= t('discover.actions.see_events_in', location: @search_location, default: "Ver eventos en #{@search_location}") %></span>
              <i class="ri-arrow-right-s-line arrow-right"></i>
            <% end %>
          <% elsif @current_tab == "genre" && @current_genre.present? && !['Todos', 'All'].include?(@current_genre) %>
            <%= link_to events_path(genre: @current_genre), class: "sheet-shortcut-action-btn" do %>
              <i class="ri-calendar-event-fill text-pink"></i>
              <span><%= t('discover.actions.see_events_of', genre: @current_genre, default: "Ver eventos de #{@current_genre}") %></span>
              <i class="ri-arrow-right-s-line arrow-right"></i>
            <% end %>
          <% else %>
            <%= link_to events_path, class: "sheet-shortcut-action-btn" do %>
              <i class="ri-calendar-event-fill text-primary"></i>
              <span><%= t('discover.actions.see_all_events', default: "Ver todos los eventos") %></span>
              <i class="ri-arrow-right-s-line arrow-right"></i>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
