<%
  artist_user = discover.dashboard&.user
  artist_name = discover.dashboard&.artist_name || "Artista FBL"
  artist_location = discover.dashboard&.artist_location || "México"
  artist_price = discover.dashboard&.artist_price

  raw_src = if discover.content.present? && (discover.content.start_with?("http") || discover.content.start_with?("/") || discover.content.start_with?("yt:") || discover.content =~ /^[a-zA-Z0-9_-]{11}$/)
              discover.content
            elsif discover.video.attached?
              url_for(discover.video)
            else
              "/main.mp4"
            end

  youtube_id = if raw_src =~ /(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?)\/|.*[?&]v=)|youtu\.be\/)([^"&?\/\s]{11})/
                 $1
               elsif raw_src.start_with?("yt:")
                 raw_src.sub("yt:", "")
               elsif raw_src =~ /^[a-zA-Z0-9_-]{11}$/
                 raw_src
               end
  is_youtube = youtube_id.present?

  video_src = if is_youtube
                raw_src
              elsif raw_src.include?("cloudinary.com") && raw_src.include?("/upload/")
                if raw_src.include?("q_auto")
                  raw_src
                else
                  raw_src.gsub("/upload/", "/upload/q_auto:good,w_480,vc_h264/")
                end
              else
                raw_src
              end
%>

<div class="tiktok-card <%= 'has-youtube' if is_youtube %>"
     id="<%= dom_id(discover) %>"
     data-tiktok-feed-target="card"
     data-video-id="<%= discover.id %>"
     data-artist-location="<%= artist_location %>"
     data-genre="<%= discover.genre %>"
     data-action="contextmenu->tiktok-feed#onContextMenu
                  touchstart->tiktok-feed#onTouchStart
                  touchmove->tiktok-feed#onTouchMove
                  touchend->tiktok-feed#onTouchEnd
                  touchcancel->tiktok-feed#onTouchCancel">

  <!-- Video Player Element -->
  <div class="tiktok-video-wrapper <%= 'is-youtube' if is_youtube %>">
    <% if is_youtube %>
      <div class="tiktok-youtube-container">
        <iframe class="tiktok-youtube-iframe"
                src="https://www.youtube-nocookie.com/embed/<%= youtube_id %>?enablejsapi=1&autoplay=0&mute=0&controls=1&modestbranding=1&rel=0&playsinline=1"
                title="<%= discover.title %>"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen>
        </iframe>
      </div>
    <% else %>
      <video class="tiktok-video"
             muted
             playsinline
             preload="metadata"
             data-tiktok-feed-target="video"
             data-action="click->tiktok-feed#togglePlay
                          timeupdate->tiktok-feed#onTimeUpdate
                          ended->tiktok-feed#onVideoEnded">
        <source src="<%= video_src %>" type="video/mp4">
      </video>

      <!-- Play/Pause Status Icon Overlay -->
      <div class="tiktok-play-indicator" data-tiktok-feed-target="playIndicator" data-action="click->tiktok-feed#onIndicatorClick">
        <i class="ri-play-fill"></i>
      </div>

      <!-- Sound Control Floating Button -->
      <button type="button" class="tiktok-sound-toggle sound-active" data-action="click->tiktok-feed#toggleMute" title="Activar/Silenciar sonido">
        <i class="ri-volume-up-fill" data-tiktok-feed-target="volumeIcon"></i>
      </button>
    <% end %>
  </div>

  <!-- Bottom Metadata Gradient Overlay (Contains card info + action icons under it) -->
  <div class="tiktok-info-overlay">
    <!-- Artist Row -->
    <div class="tiktok-artist-row">
      <%= link_to dashboard_path(discover.dashboard), class: "tiktok-artist-name" do %>
        @<%= artist_name %>
      <% end %>

      <% if is_youtube %>
        <a href="https://www.youtube.com/watch?v=<%= youtube_id %>" target="_blank" rel="noopener noreferrer" class="tiktok-youtube-badge" title="Ver en YouTube">
          <i class="ri-youtube-fill"></i>
          <span>Radios FBL Live</span>
        </a>
      <% end %>

      <% if artist_location.present? %>
        <%= link_to discovers_path(tab: "nearby", location: artist_location),
                    class: "tiktok-location-pill",
                    title: "Ver contenido de #{artist_location}" do %>
          <i class="ri-map-pin-2-fill"></i>
          <span><%= artist_location %></span>
        <% end %>
      <% end %>
    </div>

    <!-- Title Row -->
    <div class="tiktok-title-row">
      <h3 class="tiktok-song-title">
        <% if discover.general? %>
          <i class="ri-article-line text-warning"></i>
        <% else %>
          <i class="ri-music-2-fill"></i>
        <% end %>
        <%= discover.title %>
      </h3>
      <% if discover.genre.present? %>
        <%= link_to discovers_path(tab: "genre", genre: discover.genre),
                    class: "tiktok-genre-tag",
                    title: "Escuchar sólo #{discover.genre}" do %>
          <i class="ri-disc-fill"></i>
          <span><%= discover.genre %></span>
        <% end %>
      <% end %>
      <span class="tiktok-type-badge <%= discover.general? ? 'badge-general' : 'badge-music' %>">
        <%= discover.general? ? '📱 Publicación' : '🎵 Música' %>
      </span>
    </div>

    <!-- Caption / Description -->
    <% if discover.dashboard&.artist_description.present? %>
      <p class="tiktok-caption">
        <%= truncate(discover.dashboard.artist_description, length: 110) %>
      </p>
    <% end %>

    <!-- CTA Booking Buttons -->
    <div class="tiktok-booking-cta">
      <% if artist_user.present? %>
        <%= button_to chatrooms_path(user_id: artist_user.id), method: :post, class: "tiktok-cta-btn primary" do %>
          <i class="ri-chat-1-fill"></i> Contactar Artista
        <% end %>
      <% end %>

      <%= link_to dashboard_path(discover.dashboard), class: "tiktok-cta-btn secondary" do %>
        <i class="ri-calendar-check-line"></i> Ver Perfil <%= "$#{artist_price.to_i} MXN" if artist_price %>
      <% end %>
    </div>

    <!-- Action Icons Under Card Info: Pic, Like, Comment, Save, Disc -->
    <div class="tiktok-card-bottom-actions">
      <!-- 1. Pic: Artist Avatar with Follow Badge -->
      <div class="bottom-action-item avatar-action-item">
        <div class="tiktok-artist-avatar-container">
          <%= link_to dashboard_path(discover.dashboard), class: "tiktok-avatar-link", title: "Ver perfil de #{artist_name}" do %>
            <% if discover.dashboard&.avatar&.attached? %>
              <%= cl_image_tag discover.dashboard.avatar.key, class: "tiktok-avatar-img", alt: artist_name, format: :webp, quality: :auto, width: 80, height: 80, crop: :fill, loading: "lazy" %>
            <% else %>
              <div class="tiktok-avatar-placeholder">
                <%= artist_name.first.upcase %>
              </div>
            <% end %>
          <% end %>

          <% if user_signed_in? && artist_user.present? && current_user != artist_user && !current_user.following?(artist_user) %>
            <div class="tiktok-avatar-follow-badge">
              <%= button_to user_follow_path(artist_user),
                            method: :post,
                            form: { data: { turbo: true } },
                            class: "avatar-follow-btn",
                            title: "Seguir a #{artist_name}" do %>
                <i class="ri-add-line"></i>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- 2. Like (Heart) Button -->
      <div class="bottom-action-item like-action-item">
        <%= render partial: "likes/like_button", locals: { discover: discover } %>
      </div>

      <!-- 3. Comments Button -->
      <div class="bottom-action-item comment-action-item">
        <button type="button"
                class="tiktok-action-btn"
                data-action="click->tiktok-feed#openComments"
                data-discover-id="<%= discover.id %>"
                title="Comentarios">
          <div class="tiktok-action-icon">
            <i class="ri-chat-3-fill"></i>
          </div>
          <span id="discover_<%= discover.id %>_card_comments_count" class="tiktok-action-count">
            <%= number_to_human(discover.comments.count, units: { thousand: 'K', million: 'M' }, format: '%n%u') %>
          </span>
        </button>
      </div>

      <!-- 4. Save / Favorite Button -->
      <div class="bottom-action-item save-action-item">
        <%= turbo_frame_tag dom_id(discover.dashboard, :favorite_button) do %>
          <% is_fav = current_user&.favorited?(discover.dashboard) %>
          <% if is_fav %>
            <%= button_to favorite_path(id: 0, favoritable_type: "Dashboard", favoritable_id: discover.dashboard.id),
                          method: :delete,
                          class: "tiktok-action-btn liked",
                          title: "Guardado en favoritos",
                          form: { data: { turbo: true } } do %>
              <div class="tiktok-action-icon">
                <i class="ri-bookmark-fill" style="color: #FFD166;"></i>
              </div>
              <span class="tiktok-action-count">Guardado</span>
            <% end %>
          <% else %>
            <%= button_to favorites_path(favoritable_type: "Dashboard", favoritable_id: discover.dashboard.id),
                          method: :post,
                          class: "tiktok-action-btn",
                          title: "Guardar en favoritos",
                          form: { data: { turbo: true } } do %>
              <div class="tiktok-action-icon">
                <i class="ri-bookmark-line"></i>
              </div>
              <span class="tiktok-action-count">Guardar</span>
            <% end %>
          <% end %>
        <% end %>
      </div>

      <!-- 5. Disk Icon (Vinyl Disc): View on artist profile -->
      <div class="bottom-action-item disc-action-item">
        <% vinyl_url = discover.dashboard.present? ? dashboard_path(discover.dashboard, anchor: "discover-#{discover.id}") : (artist_user.present? ? user_id_path(artist_user) : "#") %>
        <%= link_to vinyl_url, class: "tiktok-vinyl-disc-link text-decoration-none", title: "#{discover.title} - Ver en perfil" do %>
          <div class="tiktok-vinyl-disc">
            <div class="vinyl-outer">
              <div class="vinyl-inner">
                <i class="ri-music-fill"></i>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Slide-up Comments Drawer -->
  <%= render partial: "comments/comments_drawer", locals: { discover: discover } %>
</div>
