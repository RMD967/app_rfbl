<div class="show-user-container">
  <h1><%= t('user.greeting', first_name: @user.first_name, last_name: @user.last_name) %></h1>
  <p class="user-email-text"><%= @user.email %></p>

  <!-- Follow Stats Bar -->
  <div class="user-follow-stats my-3 d-flex justify-content-center gap-4">
    <div class="stat-box text-center">
      <h3 class="m-0 text-white font-weight-bold"><%= @user.following.count %></h3>
      <span class="text-muted small"><%= t('user.following', default: 'Following') %></span>
    </div>
    <% if @user.artist? %>
      <div class="stat-box text-center">
        <h3 class="m-0 text-white font-weight-bold"><%= @user.followers.count %></h3>
        <span class="text-muted small"><%= t('user.followers', default: 'Followers') %></span>
      </div>
    <% end %>
  </div>

  <div class="view-profile-picture">
    <div class='user-profile-picture'>
      <% if @user.profile_picture.attached? %>
        <%= cl_image_tag @user.profile_picture.key, alt: t('user.profile_picture') %>
      <% else %>
        <%= image_tag "https://res.cloudinary.com/djuhjudsb/image/upload/v1687887823/tq49o29k_ofz8ad.png", alt: t('user.alt_profile_picture') %>
      <% end %>
      <%= form_for @user, url: update_profile_picture_user_path(@user), method: :patch, html: { data: { controller: "upload", target: "upload.form" } } do |f| %>
        <label for="my-pencil-icon" id="my-label" class="fa fa-pencil"></label>
        <%= f.file_field :profile_picture, id: 'my-pencil-icon', style: 'display: none;', data: { target: "upload.fileField" } %>
      <% end %>
    </div>
    <% if @user.profile_picture.attached? %>
      <%= form_for @user, url: delete_profile_picture_user_path(@user), method: :delete do |f| %>
        <%= f.submit t('user.delete_image'), class: 'main-app-btn-del' %>
      <% end %>
    <% end %>
  </div>

  <!-- Artists I Follow Section -->
  <% if @user.following.any? %>
    <div class="followed-artists-section my-4">
      <h4 class="mb-3 text-white"><i class="ri-user-heart-line text-primary"></i> <%= t('user.followed_artists', default: 'Artists You Follow') %> (<%= @user.following.count %>)</h4>
      <div class="d-flex flex-column gap-2">
        <% @user.following.each do |artist| %>
          <% artist_db = artist.artist_dashboard %>
          <div class="d-flex align-items-center justify-content-between p-2 rounded" style="background: #2A2A3F;">
            <div class="d-flex align-items-center gap-2">
              <% if artist.profile_picture.attached? %>
                <%= cl_image_tag artist.profile_picture.key, class: "chat-avatar", style: "width:40px;height:40px;" %>
              <% else %>
                <img src="https://res.cloudinary.com/djuhjudsb/image/upload/v1687887823/tq49o29k_ofz8ad.png" class="chat-avatar" style="width:40px;height:40px;">
              <% end %>
              <div>
                <strong class="text-white d-block"><%= artist_db&.artist_name || artist.full_name %></strong>
                <small class="text-muted"><%= artist_db&.artist_genre || "Musician" %></small>
              </div>
            </div>
            <div class="d-flex align-items-center gap-2">
              <% if artist_db %>
                <%= link_to dashboard_path(artist_db), class: "btn btn-sm btn-outline-light" do %>
                  <i class="ri-eye-line"></i> Profile
                <% end %>
              <% end %>
              <%= render partial: "follows/follow_button", locals: { artist: artist } %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="user-profile-buttons">
    <%= link_to t('user.edit_profile_info'), edit_user_registration_path %>
    <%= link_to t('user.change_password'), edit_password_user_path(@user) %>
    <%= link_to t('user.log_out'), destroy_user_session_path, data: { turbo_method: :delete }, class: ""  %>
  </div>
</div>
