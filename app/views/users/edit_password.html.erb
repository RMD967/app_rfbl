<div class="edit-profile-wrapper">
  <div class="edit-profile-top-nav">
    <%= link_to edit_user_registration_path, class: "edit-back-btn" do %>
      <i class="ri-arrow-left-line"></i>
      <span><%= t('links.back', default: 'Volver a Editar Perfil') %></span>
    <% end %>
  </div>

  <div class="edit-profile-card">
    <div class="edit-card-header">
      <div class="edit-avatar-container">
        <div class="edit-avatar-placeholder" style="background: rgba(162, 89, 255, 0.2); color: #A259FF; border-color: #A259FF;">
          <i class="ri-lock-password-line" style="font-size: 2rem;"></i>
        </div>
      </div>
      <div class="edit-header-text">
        <h1 class="edit-title"><%= t('password.change_password', default: 'Cambiar Contraseña') %></h1>
        <p class="edit-subtitle"><%= t('password.subtitle', default: 'Actualiza tus credenciales de acceso para mayor seguridad') %></p>
      </div>
    </div>

    <%= simple_form_for(@user, url: update_password_user_path(@user), html: { method: :put, class: "edit-profile-form" }) do |f| %>
      <div class="edit-form-section">
        <div class="mb-3">
          <label class="edit-field-label" for="user_current_password_change">
            <%= t('password.current_password', default: 'Contraseña Actual') %> *
          </label>
          <%= f.input_field :current_password,
                            required: true,
                            autocomplete: 'current-password',
                            class: 'edit-field-input',
                            id: 'user_current_password_change',
                            placeholder: 'Tu contraseña actual' %>
          <p class="edit-field-hint">
            <i class="ri-shield-keyhole-line"></i> <%= t('password.current_password_hint', default: 'Ingresa tu clave actual para autorizar el cambio') %>
          </p>
        </div>

        <div class="mb-3">
          <label class="edit-field-label" for="user_new_password">
            <%= t('password.new_password', default: 'Nueva Contraseña') %> *
          </label>
          <%= f.input_field :password,
                            required: true,
                            autocomplete: 'new-password',
                            class: 'edit-field-input',
                            id: 'user_new_password',
                            placeholder: 'Mínimo 6 caracteres' %>
        </div>

        <div class="mb-3">
          <label class="edit-field-label" for="user_password_confirmation">
            <%= t('password.password_confirmation', default: 'Confirmar Nueva Contraseña') %> *
          </label>
          <%= f.input_field :password_confirmation,
                            required: true,
                            autocomplete: 'new-password',
                            class: 'edit-field-input',
                            id: 'user_password_confirmation',
                            placeholder: 'Repite la nueva contraseña' %>
        </div>
      </div>

      <div class="edit-form-actions">
        <%= f.button :button, class: 'btn-save-profile' do %>
          <i class="ri-key-2-fill"></i>
          <span><%= t('password.update_password', default: 'Actualizar Contraseña') %></span>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
