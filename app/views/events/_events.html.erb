<div class="events-view-container" data-controller="events-view">
  <!-- View Toggle Bar -->
  <div class="events-view-toolbar">
    <div class="view-switch-group" role="tablist">
      <button type="button"
        class="view-switch-btn active"
        data-events-view-target="listBtn"
        data-action="click->events-view#showList"
        role="tab"
        aria-selected="true">
        <i class="ri-grid-fill"></i>
        <span>Lista de Eventos</span>
        <span class="view-count-badge"><%= events.count %></span>
      </button>

      <button type="button"
        class="view-switch-btn"
        data-events-view-target="mapBtn"
        data-action="click->events-view#showMap"
        role="tab"
        aria-selected="false">
        <i class="ri-map-2-line"></i>
        <span>Mapa Interactivo</span>
        <span class="view-count-badge"><%= markers.count %></span>
      </button>
    </div>

    <% if params[:query].present? || (params[:genre].present? && params[:genre] != "All") %>
      <%= link_to events_path, class: "clear-filters-link" do %>
        <i class="ri-refresh-line"></i> Limpiar filtros
      <% end %>
    <% end %>
  </div>

  <!-- LIST VIEW -->
  <section class="events-list-section" data-events-view-target="listView">
    <% if events.any? %>
      <div class="modern-events-grid">
        <% events.each do |event| %>
          <% next unless event && event.persisted? %>
          <article class="modern-event-card">
            <!-- Card Image & Overlays -->
            <div class="event-card-media-wrapper">
              <%= link_to event_path(event), class: "event-card-media-link" do %>
                <% if event.image.attached? %>
                  <%= cl_image_tag event.image.key, class: "event-card-cover", alt: event.title %>
                <% else %>
                  <img src="https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=600&auto=format&fit=crop&q=80"
                    class="event-card-cover"
                    alt="<%= event.title %>">
                <% end %>
              <% end %>

              <!-- Genre Pill Badge -->
              <% if event.genre.present? %>
                <span class="event-genre-badge">
                  <%= event.genre %>
                </span>
              <% end %>

              <!-- Favorite Button -->
              <div class="event-fav-action">
                <%= render partial: "favorites/favorite_button", locals: { favoritable: event } %>
              </div>
            </div>

            <!-- Card Content -->
            <div class="event-card-content">
              <!-- Organizer Row -->
              <div class="event-organizer-row">
                <% if event.user.profile_picture.attached? %>
                  <%= cl_image_tag event.user.profile_picture.key, class: "organizer-avatar", alt: event.user.first_name %>
                <% else %>
                  <img src="https://res.cloudinary.com/djuhjudsb/image/upload/v1687887823/tq49o29k_ofz8ad.png"
                    class="organizer-avatar"
                    alt="<%= event.user.first_name %>">
                <% end %>
                <div class="organizer-meta">
                  <span class="organizer-label">Organizado por</span>
                  <span class="organizer-name"><%= event.user.first_name %> <%= event.user.last_name %></span>
                </div>
              </div>

              <!-- Title -->
              <h3 class="event-card-heading">
                <%= link_to event.title, event_path(event) %>
              </h3>

              <!-- Details Rows -->
              <div class="event-details-meta">
                <div class="meta-item">
                  <i class="ri-calendar-event-line meta-icon date"></i>
                  <div class="meta-texts">
                    <span class="meta-primary"><%= format_event_date(event.datetime) %></span>
                    <% if format_event_time(event.datetime).present? %>
                      <span class="meta-secondary"><%= format_event_time(event.datetime) %></span>
                    <% end %>
                  </div>
                </div>

                <div class="meta-item">
                  <i class="ri-map-pin-2-line meta-icon location"></i>
                  <div class="meta-texts">
                    <span class="meta-primary location-text" title="<%= event.address %>"><%= event.address.presence || "Ubicación por confirmar" %></span>
                  </div>
                </div>

                <% if event.duration.present? %>
                  <div class="meta-item">
                    <i class="ri-time-line meta-icon duration"></i>
                    <div class="meta-texts">
                      <span class="meta-primary"><%= format_event_duration(event.duration) %></span>
                    </div>
                  </div>
                <% end %>
              </div>

              <!-- Card Actions -->
              <div class="event-card-actions">
                <%= link_to event_path(event), class: "btn-view-event" do %>
                  <span>Ver Evento</span>
                  <i class="ri-arrow-right-line"></i>
                <% end %>

                <% if event.geocoded? %>
                  <button type="button"
                    class="btn-view-on-map"
                    data-action="click->events-view#showMap"
                    title="Ver en el mapa">
                    <i class="ri-map-pin-line"></i>
                  </button>
                <% end %>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <!-- Empty State -->
      <div class="events-empty-state">
        <div class="empty-icon-wrap">
          <i class="ri-calendar-close-line"></i>
        </div>
        <h3 class="empty-title">No encontramos eventos</h3>
        <p class="empty-description">
          <% if params[:query].present? %>
            No hay eventos que coincidan con "<%= params[:query] %>". Intenta con otra palabra clave o explora otros géneros.
          <% else %>
            Actualmente no hay eventos en esta categoría. ¡Sé el primero en organizar uno!
          <% end %>
        </p>
        <div class="empty-actions">
          <%= link_to "Ver todos los eventos", events_path, class: "empty-reset-btn" %>
          <% if user_signed_in? && policy(Event).new? %>
            <%= link_to "Crear un Evento", new_event_path, class: "empty-create-btn" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>

  <!-- MAP WIDGET VIEW -->
  <section class="events-map-widget-section d-none" data-events-view-target="mapView">
    <div class="map-widget-card">
      <div class="map-widget-header">
        <div class="map-widget-title-area">
          <h3 class="map-widget-heading">
            <i class="ri-map-pin-user-line"></i> Mapa de Eventos
          </h3>
          <p class="map-widget-subheading">
            <%= markers.count %> <%= markers.count == 1 ? 'evento geolocalizado' : 'eventos geolocalizados' %> en el mapa. Haz click en cualquier marcador para ver los detalles.
          </p>
        </div>
        <button type="button"
          class="map-return-list-btn"
          data-action="click->events-view#showList">
          <i class="ri-list-check"></i> Ver en Lista
        </button>
      </div>

      <!-- Mapbox Map Container -->
      <div class="map-viewport-wrapper">
        <div class="events-mapbox-viewport"
          data-controller="map"
          data-events-view-target="mapContainer"
          data-map-markers-value="<%= markers.to_json %>"
          data-map-api-key-value="<%= ENV['MAPBOX_API_KEY'] %>">
        </div>
      </div>

      <!-- Quick Event Cards Drawer Under Map -->
      <% geocoded_events = events.select(&:geocoded?) %>
      <% if geocoded_events.any? %>
        <div class="map-events-carousel-area">
          <h4 class="map-events-carousel-title">Eventos mostrados en este mapa (<%= geocoded_events.count %>)</h4>
          <div class="map-events-scroll-row">
            <% geocoded_events.each do |event| %>
              <div class="map-mini-event-card">
                <% if event.image.attached? %>
                  <%= cl_image_tag event.image.key, class: "map-mini-cover", alt: event.title %>
                <% else %>
                  <img src="https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=300&auto=format&fit=crop&q=80"
                    class="map-mini-cover"
                    alt="<%= event.title %>">
                <% end %>
                <div class="map-mini-body">
                  <span class="map-mini-genre"><%= event.genre %></span>
                  <h5 class="map-mini-title"><%= event.title %></h5>
                  <p class="map-mini-date"><i class="ri-calendar-line"></i> <%= format_event_date(event.datetime) %></p>
                  <p class="map-mini-address"><i class="ri-map-pin-line"></i> <%= event.address %></p>
                  <%= link_to "Ver Evento", event_path(event), class: "map-mini-btn" %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </section>
</div>
