<div id="<%= dom_id event %>" class="event-details-card">
  <div class="event-specs-grid">
    <div class="event-spec-tile">
      <div class="spec-tile-icon"><i class="ri-calendar-check-line"></i></div>
      <div class="spec-tile-info">
        <span class="spec-label"><%= t('events.date', default: 'Fecha') %></span>
        <span class="spec-value"><%= format_event_date(event.datetime) %></span>
      </div>
    </div>
    <div class="event-spec-tile">
      <div class="spec-tile-icon"><i class="ri-time-line"></i></div>
      <div class="spec-tile-info">
        <span class="spec-label"><%= t('events.time', default: 'Hora') %></span>
        <span class="spec-value"><%= format_event_time(event.datetime) %></span>
      </div>
    </div>
    <div class="event-spec-tile">
      <div class="spec-tile-icon"><i class="ri-hourglass-fill"></i></div>
      <div class="spec-tile-info">
        <span class="spec-label"><%= t('events.duration', default: 'Duración') %></span>
        <span class="spec-value"><%= format_event_duration(event.duration) %></span>
      </div>
    </div>
    <div class="event-spec-tile">
      <div class="spec-tile-icon"><i class="ri-disc-line"></i></div>
      <div class="spec-tile-info">
        <span class="spec-label"><%= t('events.genre', default: 'Género') %></span>
        <span class="spec-value"><%= event.genre %></span>
      </div>
    </div>
  </div>
</div>
