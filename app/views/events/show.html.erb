<%= link_to :back do %>
  <i class="fas fa-arrow-left"></i>
<% end %>

<div class="event-show-container">
  <div class="event-show-image">
    <% if @event.image.attached? %>
      <%= cl_image_tag @event.image.key, class: "event-image" %>
    <% else %>
      <%= image_tag "https://picsum.photos/seed/picsum/200/200", class: "event-image" %>
    <% end %>
  </div>

  <div class="event-actions-bar my-3 d-flex flex-wrap align-items-center gap-2">
    <%= render partial: "favorites/favorite_button", locals: { favoritable: @event, show_label: true } %>

    <% if current_user != @event.user %>
      <%= button_to chatrooms_path(user_id: @event.user_id, event_id: @event.id), method: :post, class: "main-app-btn-pri" do %>
        <i class="ri-chat-3-line"></i> <%= t('events.chat_with_organizer', default: 'Chat with Organizer') %>
      <% end %>

      <% if current_user.artist? %>
        <% if current_user.applied_to?(@event) %>
          <span class="badge bg-success d-flex align-items-center px-3 py-2">
            <i class="ri-check-line me-1"></i> <%= t('events.applied', default: 'Applied') %>
          </span>
        <% else %>
          <%= link_to event_bookings_path(@event), data: { turbo_method: :post }, class: "main-app-btn-pri" do %>
            <p class="m-0"><%= t('events.postulate_position') %></p>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <% if @event.bookings.any? %>
      <div class="event-applicants my-4 p-3 rounded" style="background: #2A2A3F;">
        <h5 class="mb-3 text-white"><i class="ri-user-star-line text-primary"></i> Interested Musicians (<%= @event.bookings.count %>)</h5>
        <div class="d-flex flex-column gap-2">
          <% @event.bookings.each do |booking| %>
            <div class="d-flex align-items-center justify-content-between p-2 rounded" style="background: #1F1F2C;">
              <div class="d-flex align-items-center gap-2">
                <% if booking.user.profile_picture.attached? %>
                  <%= cl_image_tag booking.user.profile_picture.key, class: "chat-avatar", style: "width:36px;height:36px;" %>
                <% else %>
                  <img src="https://res.cloudinary.com/djuhjudsb/image/upload/v1687887823/tq49o29k_ofz8ad.png" class="chat-avatar" style="width:36px;height:36px;">
                <% end %>
                <span class="text-white"><strong><%= booking.user.full_name %></strong></span>
              </div>
              <%= button_to chatrooms_path(user_id: booking.user_id, event_id: @event.id), method: :post, class: "btn btn-sm btn-outline-primary" do %>
                <i class="ri-chat-3-line"></i> Chat
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>

  <div class="event-show-edit">
    <% if policy(@event).edit? %>
      <%= link_to edit_event_path(@event), class: "main-app-btn-pri" do %>
        <p><%= t('events.edit_this_event') %></p>
      <% end %>
    <% end %>

    <% if policy(@event).destroy? %>
      <%= button_to @event, method: :delete, data: { confirm: t('events.confirm_delete') }, class: "main-app-btn-del" do %>
        <p><%= t('events.delete_this_event') %></p>
      <% end %>
    <% end %>
  </div>

  <div class="event-show-content-row">
    <div class="event-show-details">
      <%= render @event %>
    </div>

    <div class="event-show-map">
      <div style="height: 600px;" data-controller="map" data-map-markers-value="<%= @marker.to_json %>" data-map-api-key-value="<%= ENV['MAPBOX_API_KEY'] %>"></div>
    </div>
  </div>
</div>
