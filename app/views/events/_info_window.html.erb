<div class="map-popup-card">
  <img src="<%= event_cover_image_url(event) %>" class="map-popup-thumb" alt="<%= event.title %>" loading="lazy">
  <div class="map-popup-details">
    <% if event.genre.present? %>
      <span class="map-popup-genre"><%= event.genre %></span>
    <% end %>
    <h5 class="map-popup-title"><%= event.title %></h5>
    <p class="map-popup-meta">
      <i class="ri-calendar-line"></i> <%= format_event_date(event.datetime) %>
    </p>
    <p class="map-popup-address">
      <i class="ri-map-pin-2-line"></i> <%= event.address %>
    </p>
    <%= link_to event_path(event), class: "map-popup-cta" do %>
      Ver Detalles →
    <% end %>
  </div>
</div>
