<%= turbo_frame_tag dom_id(artist, :follow_section) do %>
  <div class="follow-action-wrapper d-inline-flex align-items-center gap-3">
    <% if current_user.present? && current_user != artist %>
      <% if current_user.following?(artist) %>
        <%= button_to user_follow_path(artist),
                      method: :delete,
                      class: "btn-follow following",
                      form: { data: { turbo: true } } do %>
          <i class="ri-check-line"></i>
          <span class="btn-follow-text"><%= t('follow.following', default: 'Following') %></span>
        <% end %>
      <% else %>
        <%= button_to user_follow_path(artist),
                      method: :post,
                      class: "btn-follow not-following",
                      form: { data: { turbo: true } } do %>
          <i class="ri-user-add-line"></i>
          <span class="btn-follow-text"><%= t('follow.follow_artist', default: 'Follow') %></span>
        <% end %>
      <% end %>
    <% end %>

    <%
      artist_dashboard = artist.artist_dashboard
      can_open = artist_dashboard.present? && ((current_user == artist) || artist_dashboard.public_followers?)
    %>
    <div class="followers-pill <%= 'cursor-pointer' if can_open %>"
         <% if can_open %>
           data-bs-toggle="modal" data-bs-target="#followersModal" title="Ver lista de seguidores" style="cursor: pointer;"
         <% elsif artist_dashboard.present? && !artist_dashboard.public_followers? %>
           title="Lista de seguidores privada por el artista" style="cursor: not-allowed;"
         <% end %>>
      <i class="ri-heart-3-fill"></i>
      <strong><%= artist.followers.count %></strong>
      <span><%= t('follow.followers_label', default: 'followers') %></span>
      <% if artist_dashboard.present? && !artist_dashboard.public_followers? %>
        <i class="ri-lock-line ms-1 text-warning" style="font-size: 0.75rem;" title="<%= current_user == artist ? 'Privada para el público' : 'Lista privada' %>"></i>
      <% end %>
    </div>
  </div>
<% end %>
