<div class="my-bookings-page-wrapper">
  <!-- Top Navigation & Header -->
  <div class="my-bookings-header">
    <%= link_to events_path, class: "back-nav-pill" do %>
      <i class="ri-arrow-left-line"></i>
      <span>Volver a Eventos</span>
    <% end %>

    <div class="my-bookings-title-area">
      <div class="title-with-badge">
        <h1 class="my-bookings-title">Mis Postulaciones a Eventos</h1>
        <span class="bookings-count-pill"><%= @my_bookings.count %></span>
      </div>
      <p class="my-bookings-subtitle">
        Gestiona los eventos a los que has solicitado presentarte como artista.
      </p>
    </div>
  </div>

  <% if @my_bookings.empty? %>
    <div class="bookings-empty-card">
      <div class="empty-icon-circle">
        <i class="ri-ticket-line"></i>
      </div>
      <h3>No tienes postulaciones activas</h3>
      <p>Aún no te has postulado a ningún evento. Explora los eventos disponibles y envía tu solicitud como artista.</p>
      <%= link_to "Explorar Eventos", events_path, class: "btn-explore-events" %>
    </div>
  <% else %>
    <div class="my-bookings-grid">
      <% @my_bookings.each do |booking| %>
        <% event = booking.event %>
        <% next unless event %>
        <article class="my-booking-card">
          <!-- Card Image & Status -->
          <div class="booking-card-media">
            <img src="<%= event_cover_image_url(event) %>"
                 class="booking-cover-img"
                 loading="lazy"
                 alt="<%= event.title %>">
            <span class="booking-status-badge">
              <i class="ri-checkbox-circle-fill"></i> Postulado
            </span>
            <% if event.genre.present? %>
              <span class="booking-genre-tag"><%= event.genre %></span>
            <% end %>
          </div>

          <!-- Card Body -->
          <div class="booking-card-body">
            <!-- Organizer Row -->
            <div class="booking-organizer-row">
              <% if event.user.profile_picture.attached? %>
                <%= cl_image_tag event.user.profile_picture.key, class: "booking-organizer-avatar", alt: event.user.first_name %>
              <% else %>
                <img src="https://res.cloudinary.com/djuhjudsb/image/upload/v1687887823/tq49o29k_ofz8ad.png"
                  class="booking-organizer-avatar"
                  alt="<%= event.user.first_name %>">
              <% end %>
              <div class="organizer-info">
                <span class="organizer-role">Organizador</span>
                <span class="organizer-name"><%= event.user.first_name %> <%= event.user.last_name %></span>
              </div>
            </div>

            <!-- Title -->
            <h3 class="booking-event-title">
              <%= link_to event.title, event_path(event) %>
            </h3>

            <!-- Details Meta -->
            <div class="booking-meta-list">
              <div class="booking-meta-item">
                <i class="ri-calendar-line date-icon"></i>
                <div class="meta-wrap">
                  <span class="meta-date"><%= format_event_date(event.datetime) %></span>
                  <% if format_event_time(event.datetime).present? %>
                    <span class="meta-time"><%= format_event_time(event.datetime) %></span>
                  <% end %>
                </div>
              </div>
              <div class="booking-meta-item">
                <i class="ri-map-pin-2-line loc-icon"></i>
                <span class="truncate-loc"><%= event.address.presence || "Ubicación por confirmar" %></span>
              </div>
              <% if event.duration.present? %>
                <div class="booking-meta-item">
                  <i class="ri-time-line dur-icon"></i>
                  <span><%= format_event_duration(event.duration) %></span>
                </div>
              <% end %>
            </div>

            <!-- Actions -->
            <div class="booking-actions-row">
              <%= link_to event_path(event), class: "btn-booking-view" do %>
                <i class="ri-eye-line"></i> Ver Detalles
              <% end %>

              <%= button_to event_booking_path(event, booking),
                method: :delete,
                class: "btn-booking-cancel",
                data: { turbo_confirm: "¿Estás seguro de que deseas cancelar tu postulación a este evento?" } do %>
                <i class="ri-close-circle-line"></i> Cancelar
              <% end %>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  <% end %>
</div>
