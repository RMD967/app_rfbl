<div class="signup-card-container">
  <div class="signup-header text-center mb-4">
    <h2 class="signup-title"><%= t('password.forgot_title', default: '¿Olvidaste tu contraseña?') %></h2>
    <p class="signup-subtitle text-muted">Te enviaremos las instrucciones para restablecerla a tu correo</p>
  </div>

  <div class="signup-flat-card">
    <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <%= f.error_notification %>

      <div class="form-inputs mb-3">
        <%= f.input :email,
                    required: true,
                    autofocus: true,
                    input_html: { autocomplete: "email", class: "login-flat-input", placeholder: "tu@email.com" },
                    label: t('password.email', default: 'Correo electrónico'),
                    label_html: { class: "login-flat-label" } %>
      </div>

      <div class="form-actions text-center mt-3">
        <%= f.button :submit, t('password.send_instructions_button', default: 'Enviar instrucciones'), class: "btn login-flat-submit-btn" %>
      </div>
    <% end %>
  </div>

  <div class="text-center mt-4">
    <%= link_to t('devise.log_in', default: 'Volver al inicio de sesión'), new_session_path(resource_name), class: "login-signup-link fw-semibold" %>
  </div>
</div>
