<% if user_signed_in? %>
  <footer class="app-modern-footer">
    <div class="footer-main-grid">
      <!-- Brand & Mission Column -->
      <div class="footer-col footer-brand-col">
        <div class="footer-brand-header">
          <%= link_to root_path, class: "footer-brand-logo-link" do %>
            <% if current_user.artist? %>
              <% image_url = I18n.locale == :es ? "https://i.postimg.cc/vT8T1xPJ/Copy-of-Clean-Modern-App-Portfolio-Mockup-Presentation-1.png" : "https://i.postimg.cc/bN5zHBCV/Copy-of-Clean-Modern-App-Portfolio-Mockup-Presentation-2.png" %>
              <img src="<%= image_url %>" alt="Artist FBL" class="footer-brand-img">
            <% else %>
              <img src="https://i.postimg.cc/8cmBhvmN/Copy-of-Clean-Modern-App-Portfolio-Mockup-Presentation.png" alt="Radios FBL" class="footer-brand-img">
            <% end %>
          <% end %>
        </div>

        <p class="footer-tagline"><%= t('footer.own_music') %></p>

        <div class="footer-social-row">
          <a href="https://github.com/RMD96/app_rfbl" class="footer-social-pill" target="_blank" rel="noopener noreferrer" title="GitHub" aria-label="GitHub">
            <i class="ri-github-fill"></i>
          </a>
          <a href="https://www.facebook.com/radios.f.b.l" class="footer-social-pill" target="_blank" rel="noopener noreferrer" title="Facebook" aria-label="Facebook">
            <i class="ri-facebook-circle-fill"></i>
          </a>
          <a href="https://www.instagram.com/estudio.fbl/" class="footer-social-pill" target="_blank" rel="noopener noreferrer" title="Instagram" aria-label="Instagram">
            <i class="ri-instagram-line"></i>
          </a>
        </div>
      </div>

      <!-- Explore Navigation Column -->
      <div class="footer-col footer-explore-col">
        <h4 class="footer-col-heading"><%= t('footer.explore_title') %></h4>
        <nav class="footer-links-list">
          <%= link_to discovers_path, class: "footer-link-item" do %>
            <i class="ri-compass-3-line"></i>
            <span><%= t('footer.see_content') %></span>
          <% end %>

          <% if current_user.artist? %>
            <%= link_to dashboards_path, class: "footer-link-item" do %>
              <i class="ri-music-2-line"></i>
              <span><%= t('footer.upload_music') %></span>
            <% end %>
          <% else %>
            <%= link_to user_id_path(id: current_user.id), class: "footer-link-item" do %>
              <i class="ri-mic-line"></i>
              <span><%= t('footer.be_artist') %></span>
            <% end %>
          <% end %>

          <%= link_to new_event_path, class: "footer-link-item" do %>
            <i class="ri-calendar-event-line"></i>
            <span><%= t('footer.create_event') %></span>
          <% end %>
        </nav>
      </div>

      <!-- Newsletter Subscription Form Component Column -->
      <div class="footer-col footer-newsletter-col">
        <%= render "shared/newsletter_form" %>
      </div>
    </div>

    <!-- Bottom Bar (Language Switcher + Copyright) -->
    <div class="footer-bottom-row">
      <div class="footer-lang-container">
        <span class="lang-status-text">
          <i class="ri-global-line"></i> <%= t('footer.you_are_in') %>
        </span>
        <% if I18n.locale == :en %>
          <%= link_to set_language_path(locale: :es), class: "footer-lang-switcher-btn", data: { turbo: false } do %>
            <span><%= t('footer.change_to_es') %></span>
            <i class="ri-arrow-right-line"></i>
          <% end %>
        <% else %>
          <%= link_to set_language_path(locale: :en), class: "footer-lang-switcher-btn", data: { turbo: false } do %>
            <span><%= t('footer.change_to_en') %></span>
            <i class="ri-arrow-right-line"></i>
          <% end %>
        <% end %>
      </div>

      <p class="footer-copyright-text">
        © Radios FBL <%= Time.now.year %> · All rights reserved.
      </p>
    </div>
  </footer>
<% end %>
