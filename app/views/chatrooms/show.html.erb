<div class="chat-container">
  <!-- Top bar -->
  <div class="chat-header">
    <%= link_to chatrooms_path, class: "chat-back-btn" do %>
      <i class="ri-arrow-left-line ri-xl"></i>
    <% end %>

    <div class="chat-recipient-info">
      <% if @other_user&.profile_picture&.attached? %>
        <%= cl_image_tag @other_user.profile_picture.key, class: "chat-avatar", alt: @other_user.full_name %>
      <% else %>
        <img src="https://res.cloudinary.com/djuhjudsb/image/upload/v1687887823/tq49o29k_ofz8ad.png" class="chat-avatar" alt="Avatar">
      <% end %>
      <div class="chat-recipient-text">
        <h4 class="chat-recipient-name"><%= @other_user&.full_name || @chatroom.name %></h4>
        <span class="chat-recipient-badge">
          <% if @other_user&.artist? %>
            <i class="ri-music-2-fill"></i> <%= t('chat.musician', default: 'Musician') %>
          <% else %>
            <i class="ri-calendar-event-fill"></i> <%= t('chat.organizer', default: 'Event Organizer') %>
          <% end %>
        </span>
      </div>
    </div>
  </div>

  <!-- Messages scroll area -->
  <div class="chat-body"
       data-controller="chatroom-subscription"
       data-chatroom-subscription-chatroom-id-value="<%= @chatroom.id %>"
       data-chatroom-subscription-current-user-id-value="<%= current_user.id %>">
    
    <div class="chat-messages" data-chatroom-subscription-target="messages">
      <% if @chatroom.messages.empty? %>
        <div class="chat-empty-state">
          <i class="ri-chat-smile-2-line ri-3x"></i>
          <p><%= t('chat.no_messages_yet', default: 'No messages yet. Send a message below to coordinate details!') %></p>
        </div>
      <% else %>
        <% @chatroom.messages.each do |message| %>
          <%= render "messages/message", message: message, current_user: current_user %>
        <% end %>
      <% end %>
    </div>

    <!-- Message input form -->
    <div class="chat-input-bar">
      <%= simple_form_for [@chatroom, @message],
          html: {
            data: {
              chatroom_subscription_target: "form",
              action: "turbo:submit-end->chatroom-subscription#resetForm"
            },
            class: "chat-form"
          } do |f| %>
        <%= f.input :content,
            label: false,
            placeholder: t('chat.type_message', default: "Type a message..."),
            input_html: {
              data: { chatroom_subscription_target: "input" },
              class: "chat-input",
              autocomplete: "off"
            },
            wrapper_html: { class: "chat-input-wrapper" } %>
        <%= button_tag type: 'submit', class: 'chat-send-btn' do %>
          <i class="ri-send-plane-fill"></i>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
