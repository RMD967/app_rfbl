<div class="fav-card" id="<%= dom_id(dashboard, :fav_card) %>">
  <div class="fav-card-img-wrapper">
    <% if dashboard.avatar.attached? %>
      <%= cl_image_tag dashboard.avatar.key, class: "fav-card-img" %>
    <% else %>
      <img src="https://res.cloudinary.com/djuhjudsb/image/upload/v1687887823/tq49o29k_ofz8ad.png" class="fav-card-img" alt="<%= dashboard.artist_name %>">
    <% end %>
    <div class="fav-card-badge artist-badge">
      <i class="ri-music-2-line"></i> Musician
    </div>
    <div class="fav-card-action">
      <%= render partial: "favorites/favorite_button", locals: { favoritable: dashboard } %>
    </div>
  </div>

  <div class="fav-card-body">
    <h5 class="fav-card-title"><%= link_to dashboard.artist_name, dashboard_path(dashboard), class: "text-white text-decoration-none" %></h5>
    <p class="fav-card-date"><i class="ri-music-line text-primary"></i> <%= dashboard.artist_genre %> • <%= dashboard.artist_instrument %></p>
    <p class="fav-card-location"><i class="ri-map-pin-line text-danger"></i> <%= dashboard.artist_location %></p>
    
    <div class="fav-card-footer mt-2 d-flex justify-content-between align-items-center">
      <span class="text-success font-weight-bold">$<%= dashboard.artist_price %>/event</span>
      <%= link_to dashboard_path(dashboard), class: "btn btn-sm btn-outline-primary" do %>
        View Profile <i class="ri-arrow-right-line"></i>
      <% end %>
    </div>
  </div>
</div>
